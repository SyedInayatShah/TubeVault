{
  "manifest_version": 3,
  "name": "TubeVault – Download for Offline",
  "version": "1.5.7",
  "description": "Adds download buttons to YouTube videos, Shorts and playlists that save them to the TubeVault Mac app for offline viewing.",
  "key": "",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "http://127.0.0.1:47823/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content.js",
        "playlist.js",
        "shorts-all.js"
      ],
      "css": [
        "content.css",
        "playlist.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Download this video with TubeVault",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
