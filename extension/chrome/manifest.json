{
  "manifest_version": 3,
  "name": "TubeVault – Download for Offline",
  "version": "1.1.1",
  "description": "Adds a download button to the YouTube player that saves the video to the TubeVault Mac app for offline viewing.",
  "permissions": ["contextMenus", "scripting", "activeTab"],
  "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*", "http://127.0.0.1:47823/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Download this video with TubeVault",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
